            "credential.revoked",
            "monitor.run_ready",
            "monitor.alert_reserved",
            "notification.delivery_reported",
            "room.history_sync_requested",
            "room.binding_confirmed",
            "payment.order_requested",
            "audit.recorded"
          ],
          "title": "Type",
          "type": "string"
        },
        "schema_version": {
          "const": 1,
          "title": "Schema Version",
          "type": "integer"
        },
        "producer": {
          "enum": [
            "identity",
            "school_adapter",
            "room",
            "monitoring",
            "notification",
            "payment",
            "gateway"
          ],
          "title": "Producer",
          "type": "string"
        },
        "aggregate_id": {
          "format": "uuid",
          "title": "Aggregate Id",
          "type": "string"
        },
        "aggregate_version": {
          "minimum": 1,
          "title": "Aggregate Version",
          "type": "integer"
        },
        "occurred_at": {
          "format": "date-time",
          "title": "Occurred At",
          "type": "string"
        },
        "request_id": {
          "format": "uuid",
          "title": "Request Id",
          "type": "string"
        },
        "payload": {
          "anyOf": [
            {
              "$ref": "#/$defs/CredentialPayload"
            },
            {
              "$ref": "#/$defs/RunReadyPayload"
            },
            {
              "$ref": "#/$defs/AlertReservedPayload"
            },
            {
              "$ref": "#/$defs/DeliveryReportedPayload"
            },
            {
              "$ref": "#/$defs/HistorySyncPayload"
            },
            {
              "$ref": "#/$defs/BindingConfirmedPayload"
            },
            {
              "$ref": "#/$defs/OrderRequestedPayload"
            },
            {
              "$ref": "#/$defs/AuditPayload"
            }
          ],
          "title": "Payload"
        },
        "dedupe_key": {
          "maxLength": 128,
          "minLength": 1,
          "title": "Dedupe Key",
          "type": "string"
        }
      },
      "required": [
        "event_id",
        "type",
        "schema_version",
        "producer",
        "aggregate_id",
        "aggregate_version",
        "occurred_at",
        "request_id",
        "payload",
        "dedupe_key"
      ],
      "title": "EventEnvelope",
      "type": "object"
    }
  }
}
