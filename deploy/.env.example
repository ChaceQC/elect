# T2 Compose 公开配置；密码、连接 URL、私钥仅在受限 Secret 文件中。
ELECT_DOMAIN=elect.example.edu
ELECT_TLS_CERT_FILE=/opt/elect/secrets/tls/fullchain.pem
ELECT_TLS_KEY_FILE=/opt/elect/secrets/tls/privkey.pem
ELECT_SECRETS_DIR=/opt/elect/secrets

# 应用镜像由两端 Dockerfile 构建；基础服务固定版本和摘要。
ELECT_IMAGE=elect-backend:v0.14.0
ELECT_WEB_IMAGE=elect-frontend:v0.14.0
MYSQL_IMAGE=mysql:8.4.8@sha256:2952e3be7807f06fc18de50b3ea1a632d5c70d63482ff7d7376fe3aa8999babf
REDIS_IMAGE=redis:7.4.7-alpine@sha256:02f2cc4882f8bf87c79a220ac958f58c700bdec0dfb9b9ea61b62fb0e8f1bfcf
RABBITMQ_IMAGE=rabbitmq:4.1.4-management-alpine@sha256:5cbd7145b0306399ad68422c3350b6cbd1bb95704b39f5896480e5b6d4238a04

# 四类外部副作用分别授权；测试/备份恢复一律默认关闭。
# 后台开关独立于副作用；恢复覆盖强制false，合并模式由专用Compose选择。
ELECT_BACKGROUND_ENABLED=true
ELECT_ALLOW_SCHOOL_BINDING_WRITES=false
ELECT_ALLOW_PAYMENT_ORDER_WRITES=false
ELECT_ALLOW_PAYMENT_FORM_WRITES=false
ELECT_ALLOW_REAL_SMTP=false
ELECT_PAYMENT_ACCEPTANCE_PASSED=false

# 每服务私钥、公钥 trust bundle 和本域 URL 由 Compose 挂载对应 runtime JSON。
