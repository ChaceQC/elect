[mysqld]
# 8个应用池共24条连接，另外16条留给迁移、备份和运维。
max_connections=40
innodb_buffer_pool_size=128M
innodb_log_buffer_size=16M
key_buffer_size=1M
# 保留语句/等待/锁诊断，限制自动扩容的实例和历史容量。
performance_schema=ON
performance_schema_max_thread_instances=64
performance_schema_max_table_instances=512
performance_schema_max_table_handles=512
performance_schema_accounts_size=16
performance_schema_hosts_size=16
performance_schema_users_size=16
performance_schema_digests_size=256
performance_schema_max_digest_length=512
performance_schema_max_sql_text_length=512
performance_schema_max_prepared_statements_instances=128
performance_schema_events_statements_history_size=5
performance_schema_events_statements_history_long_size=100
performance_schema_events_waits_history_size=5
performance_schema_events_waits_history_long_size=100
performance_schema_events_stages_history_size=5
performance_schema_events_stages_history_long_size=100
performance_schema_events_transactions_history_size=5
performance_schema_events_transactions_history_long_size=100
table_open_cache=256
table_definition_cache=400
temptable_max_ram=32M
tmp_table_size=8M
max_heap_table_size=8M
